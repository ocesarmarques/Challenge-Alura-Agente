# ============================================================
# ImobIA — configuração local
# Nunca envie o arquivo .env real para o GitHub.
# ============================================================

# Aplicação
APP_TITLE=ImobIA
TOP_K=5
MIN_RELEVANCE_SCORE=0.32
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# OCI — autenticação
# config_file = execução local com ~/.oci/config
# instance_principal = execução em VM OCI sem chave PEM
OCI_AUTH_MODE=config_file
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_REGION=sa-saopaulo-1

# OCID do compartment em que o projeto usará o Generative AI.
OCI_COMPARTMENT_ID=

# Deixe vazio para o SDK resolver o endpoint regional automaticamente.
OCI_GENAI_ENDPOINT=

# Embeddings
OCI_EMBEDDING_MODEL_ID=cohere.embed-v4.0
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32

# Chat
OCI_CHAT_MODEL_ID=cohere.command-a-03-2025
CHAT_TEMPERATURE=0.10
CHAT_MAX_TOKENS=700
